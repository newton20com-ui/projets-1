# Document d'inventaire, valeurs VIDES volontairement. Ne pas committer les secrets.
# Variables PUBLIQUES client (dans js/config.js une fois le projet dédié créé)
ATLAS_SUPABASE_URL=
ATLAS_SUPABASE_PUBLISHABLE_KEY=

# Secrets Supabase Edge Functions, à renseigner dans Supabase > Edge Functions > Secrets
# Supabase fournit automatiquement SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY côté Edge Function.
ATLAS_ALLOWED_ORIGINS=
ATLAS_TRACKING_SECRET=
ATLAS_RATE_SECRET=
ATLAS_RESEND_API_KEY=
ATLAS_EMAIL_FROM=
ATLAS_NOTIFICATION_TO=
